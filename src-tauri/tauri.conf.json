{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SevenMediaStudio",
  "version": "0.1.5",
  "identifier": "com.sevenmediastudio.desktop",
  "build": {
    "frontendDist": "placeholder",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SevenMediaStudio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "windowEffects": {
          "effects": ["headerView"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../.next/standalone": "server",
      "../runtime/node": "runtime/node",
      "../runtime/ffmpeg": "runtime/ffmpeg",
      "../runtime/ffprobe": "runtime/ffprobe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
